      "dsec": {
        "train_sequences": 35,
        "manifest": "tools/manifests/dsec_stage1_common_v1.json"
      },
      "m3ed": {
        "train_sequences": 3,
        "manifest": "tools/manifests/m3ed_stage1_common_v1.json"
      }
    },
    "conditions": {
      "E1": "E1 Encoder＋LSTM（h蒸留）・Patchwise LSTM（12層後）",
      "E1_b3": "E1 Encoder＋LSTM（h蒸留）・Patchwise LSTM（3層後）",
      "E1_b6": "E1 Encoder＋LSTM（h蒸留）・Patchwise LSTM（6層後）",
      "E1_b9": "E1 Encoder＋LSTM（h蒸留）・Patchwise LSTM（9層後）",
